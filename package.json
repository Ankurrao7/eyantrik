{
	"name": "eyantrik",
	"description": "eYantrik — B2B manufacturing marketplace connecting buyers with verified job shops in India",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"db:reset": "node --env-file=.env scripts/db-reset.ts",
		"db:migrate": "node --env-file=.env scripts/db-migrate.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.19.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"engines": {
		"node": ">=22.18"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"mongodb": "^7.7.0"
	}
}
